# Get these from https://console.twilio.com (Account Info panel)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# A Twilio phone number you own (Phone Numbers > Manage > Active numbers), E.164 format
TWILIO_FROM_NUMBER=+15550001111

# The phone you want the app to ring, E.164 format (country code, no spaces)
MY_PHONE_NUMBER=+15551234567

# Optional: require this password to place calls (recommended if you host it online)
APP_PASSWORD=

PORT=3000

# ---------- Personal assistant (/assistant) ----------

# Anthropic API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Optional: a private iCal link so the assistant can read your calendar.
# Google Calendar: Settings > your calendar > Integrate calendar > "Secret address in iCal format"
CALENDAR_ICS_URL=

# Your time zone (IANA name). Defaults to the server's time zone.
TIME_ZONE=America/New_York

# Optional: where your notes are stored (git-ignored).
# Defaults to data/notes.json, or notes.json on the attached volume when running on Railway.
NOTES_FILE=

# Optional: a long random string shared with the Bland phone agent (see README > Phone agent).
# Generate one with: node -e "console.log(crypto.randomUUID())"
AGENT_TOKEN=

# ---------- Noise alerts (/listen) ----------

# A long, hard-to-guess ntfy topic name. Anyone who knows it can read your alerts.
# Subscribe to the same topic on your computer to get notifications (see README > Noise alerts).
NTFY_TOPIC=
# Optional: your own ntfy server instead of the public one
NTFY_SERVER=https://ntfy.sh

# Optional: also POST each alert as JSON to this URL (for Jarvis or any other app)
JARVIS_WEBHOOK_URL=
